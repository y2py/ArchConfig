
# Shell & Window
command = fish
title = ghostty
window-padding-x = 25
window-padding-y = 25
background-opacity = 0.78

# Fonts & Rendering
font-family = "JetBrains Mono Nerd Font"
font-family = "Vazir Code"
font-size = 12

# Cursor
cursor-style = bar

# Scrollback
scrollback-limit = 10000

# Key Bindings
keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down


color_function_desc=#cee9ff

# Tree view colors
color_tree_line=#527a95
color_tree_collapsed=#6bd2ff
color_tree_expanded=#2db8fe

# Load average colors
color_load_low=#97edff
color_load_med=#d0f9f4
color_load_high=#8ab5ff

# Priority colors

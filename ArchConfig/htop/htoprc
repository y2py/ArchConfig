color_cpu_med=#d0f9f4
color_cpu_high=#8ab5ff

# Memory meter colors
color_mem_used=#71c6f6
color_mem_buffers=#aae9ff
color_mem_cache=#7fd2f7
color_mem_available=#97edff

# Process list colors
color_process_normal=#cee9ff
color_process_running=#97edff
color_process_sleeping=#527a95
color_process_zombie=#8ab5ff
color_process_stopped=#d0f9f4

# Header and border colors
color_header=#88b0cd
color_border=#527a95
color_separator=#224c65

# Function key colors


# Shell & Window
shell               fish
window_padding_width 14
background_opacity  0.78

confirm_os_window_close 0

# Fallback font (Vazir Code)
# font_family         Vazir Code


# Cursor & Trail Animation
cursor_shape        beam
cursor_beam_thickness 1.5
cursor_trail        3
cursor_trail_decay  0.1 0.3

# Scrollback
scrollback_lines    10000

# Key Bindings
map page_up         scroll_page_up
map page_down       scroll_page_down
map ctrl+shift+f    show_scrollback



# BEGIN_KITTY_FONTS
font_family     family="JetBrains Mono Nerd"

#font_family      family="Monocraft Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.5


symbol_map U+0600-U+06FF,U+0750-U+077F,U+08A0-U+08FF,U+FB50-U+FDFF,U+FE70-U+FEFF Cairo
# END_KITTY_FONTS
